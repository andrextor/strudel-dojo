# Enables the Sensei (hints, boss reviews, code explanations). Without it the app works and bosses are self-assessed.
ANTHROPIC_API_KEY=

# Enables cloud sync (docs/specs/10-cloud-sync.md). Both are public; without them the app stays local.
# Local values are printed by `pnpm db:start`.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
