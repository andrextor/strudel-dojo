---
import { getCurriculum, getStages } from '../../features/curriculum/index.ts'
import { stageOutline } from '../../features/curriculum/schema.ts'
import StrudelHome from '../../features/strudel-course/StrudelHome.tsx'
import BaseLayout from '../../layouts/BaseLayout.astro'

const [curriculum, stages] = await Promise.all([getCurriculum(), getStages()])
---

<BaseLayout title="Curso Strudel">
  <StrudelHome client:only="preact" stages={stages.map(stageOutline)} curriculum={curriculum}>
    <div slot="fallback" class="min-h-96"></div>
  </StrudelHome>
</BaseLayout>
