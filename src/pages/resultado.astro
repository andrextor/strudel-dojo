---
import { getCurriculum } from '../features/curriculum/index.ts'
import ResultView from '../features/result/ResultView.tsx'
import BaseLayout from '../layouts/BaseLayout.astro'

const curriculum = await getCurriculum()
---

<BaseLayout title="Resultado">
  <ResultView client:only="preact" curriculum={curriculum}>
    <div slot="fallback" class="min-h-96"></div>
  </ResultView>
</BaseLayout>
