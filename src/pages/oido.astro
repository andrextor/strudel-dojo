---
import { getCurriculum } from '../features/curriculum/index.ts'
import EarGym from '../features/ear/EarGym.tsx'
import BaseLayout from '../layouts/BaseLayout.astro'

const curriculum = await getCurriculum()
---

<BaseLayout title="Oído" description="Entrena intervalos de oído, sin nota y con racha.">
  <EarGym client:only="preact" curriculum={curriculum}>
    <div slot="fallback" class="min-h-96"></div>
  </EarGym>
</BaseLayout>
