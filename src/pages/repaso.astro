---
import { getCurriculum } from '../features/curriculum/index.ts'
import ReviewSession from '../features/review/ReviewSession.tsx'
import BaseLayout from '../layouts/BaseLayout.astro'

const curriculum = await getCurriculum()
---

<BaseLayout title="Repaso" description="Diez preguntas de lo que más te cuesta, a su debido tiempo.">
  <ReviewSession client:only="preact" curriculum={curriculum}>
    <div slot="fallback" class="min-h-96"></div>
  </ReviewSession>
</BaseLayout>
