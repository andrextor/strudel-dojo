---
import { getCurriculum, getStages } from '../features/curriculum/index.ts'
import { stageOutline } from '../features/curriculum/schema.ts'
import ReviewSession from '../features/review/ReviewSession.tsx'
import BaseLayout from '../layouts/BaseLayout.astro'

const [curriculum, stages] = await Promise.all([getCurriculum(), getStages()])
---

<BaseLayout title="Repaso" description="Diez preguntas de lo que más te cuesta, a su debido tiempo.">
  <ReviewSession client:only="preact" curriculum={curriculum} stages={stages.map(stageOutline)}>
    <div slot="fallback" class="min-h-96"></div>
  </ReviewSession>
</BaseLayout>
