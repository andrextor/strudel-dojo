          "id": "M01-T02-K1",
          "title": "Cuatro notas",
          "brief": "Toca Do, Re, Mi y Fa con `note` y el sonido de piano.",
          "starter": "note(\"c d e\").s(\"piano\")",
          "solution": "note(\"c d e f\").s(\"piano\")",
          "cycles": 1,
          "assertions": [
