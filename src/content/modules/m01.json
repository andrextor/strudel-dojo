      "katas": [
        {
          "id": "M01-T03-K1",
          "title": "Quintas en paralelo",
          "brief": "Toca la melodía C D E F G y súmale una quinta justa arriba a cada nota, como un power chord.",
          "starter": "note(\"c3 d3 e3 f3 g3\").s(\"piano\")",
          "solution": "note(\"[c3,g3] [d3,a3] [e3,b3] [f3,c4] [g3,d4]\").s(\"piano\")",
          "cycles": 1,
          "assertions": [
            {
              "type": "usesFunction",
              "names": ["note"]
            },
            {
              "type": "harmonicIntervals",
              "interval": "5P",
              "minRatio": 1
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["C", "D", "E", "F", "G"],
              "voice": "lowest"
            }
          ],
          "hints": [
            "La coma dentro de `[ ]` hace que dos notas suenen juntas: `[c3,g3]`.",
            "Una quinta justa son 7 semitonos: de E sube a B, de F sube a C."
          ]
        },
        {
          "id": "M01-T03-K2",
          "title": "Melodía por intervalos",
          "brief": "Empieza en c4 y sube una tercera mayor, luego una cuarta justa y por último una segunda menor. Termina con un silencio.",
          "starter": "note(\"c4 ~\").s(\"piano\")",
          "solution": "note(\"c4 e4 a4 bb4 ~\").s(\"piano\")",
          "cycles": 1,
          "assertions": [
            {
              "type": "usesFunction",
              "names": ["note"]
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["C", "E", "A", "Bb"],
              "voice": "all"
            },
            {
              "type": "eventsPerCycle",
              "min": 4,
              "max": 4
            }
          ],
          "hints": [
            "3M = 4 semitonos, 4J = 5, 2m = 1.",
            "`~` es un silencio: ocupa un paso pero no suena."
          ]
        },
        {
          "id": "M01-T03-K3",
          "title": "Un intervalo por ciclo",
          "brief": "Deja c3 fijo y, con `< >`, haz que suene arriba una tercera mayor en el ciclo 1, una quinta justa en el 2 y una octava en el 3.",
          "starter": "note(\"[c3,e3]\").s(\"piano\")",
          "solution": "note(\"[c3,<e3 g3 c4>]\").s(\"piano\")",
          "cycles": 3,
          "assertions": [
            {
              "type": "usesFunction",
              "names": ["note"]
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["C", "E"],
              "voice": "all",
              "cycle": 0
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["C", "G"],
              "voice": "all",
              "cycle": 1
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["C", "C"],
              "voice": "all",
              "cycle": 2
            }
          ],
          "hints": [
            "`< >` toma un elemento distinto en cada ciclo.",
            "Puedes poner `< >` dentro de los corchetes: `[c3,<… … …>]`."
          ]
        }
      ]
