{
  "id": "S04",
  "order": 4,
  "title": "Escalas y tonalidades",
  "summary": "De notas sueltas a grados: n, scale y transformaciones de patrones.",
  "prerequisite": "S03",
  "units": [
    {
      "id": "S04-U01",
      "title": "Grados con n y scale",
      "goal": "Tocar cualquier escala mayor por grados.",
      "lesson": "s04-u01",
      "requires": ["M02-T01"],
      "katas": [
        {
          "id": "M02-T01-K1",
          "title": "Do mayor por grados",
          "brief": "Toca la escala de Do mayor de la tónica a la octava con `n` y `scale` (grados 0 a 7).",
          "starter": "n(\"0 1 2 3\").scale(\"C:major\").s(\"piano\")",
          "solution": "n(\"0 1 2 3 4 5 6 7\").scale(\"C:major\").s(\"piano\")",
          "cycles": 1,
          "assertions": [
            {
              "type": "usesFunction",
              "names": ["n", "scale"]
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["C", "D", "E", "F", "G", "A", "B", "C"],
              "voice": "all"
            }
          ],
          "hints": ["El grado 0 es la tónica; el 7 es la tónica una octava arriba."]
        },
        {
          "id": "M02-T01-K2",
          "title": "Cambia la tónica",
          "brief": "Toca la escala de Re mayor completa, subiendo, con `n` y `scale`.",
          "starter": "n(\"0 1 2 3 4 5 6 7\").scale(\"C:major\").s(\"piano\")",
          "solution": "n(\"0 1 2 3 4 5 6 7\").scale(\"D:major\").s(\"piano\")",
          "cycles": 1,
          "assertions": [
            {
              "type": "usesFunction",
              "names": ["n", "scale"]
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["D", "E", "F#", "G", "A", "B", "C#", "D"],
              "voice": "all"
            },
            {
              "type": "notesWithinScale",
              "scale": "D major"
            }
          ],
          "hints": ["Solo cambia la tónica dentro de `scale(\"…:major\")`."]
        },
        {
          "id": "M02-T01-K3",
          "title": "La sensible que resuelve",
          "brief": "Toca la escala de La mayor subiendo y, al llegar arriba, baja a la sensible (G♯) y vuelve a la tónica.",
          "starter": "n(\"0 1 2 3 4 5 6 7\").scale(\"A:major\").s(\"piano\")",
          "solution": "n(\"0 1 2 3 4 5 6 7 6 7\").scale(\"A:major\").s(\"piano\")",
          "cycles": 1,
          "assertions": [
            {
              "type": "usesFunction",
              "names": ["n", "scale"]
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["A", "B", "C#", "D", "E", "F#", "G#", "A", "G#", "A"],
              "voice": "all"
            },
            {
              "type": "notesWithinScale",
              "scale": "A major"
            }
          ],
          "hints": [
            "La sensible es el grado 7 de la escala: en `n` es el número 6 (se cuenta desde 0)."
          ]
        }
      ]
    },
    {
      "id": "S04-U02",
      "title": "Una tonalidad por ciclo",
      "goal": "Cambiar de tonalidad en cada ciclo con < >.",
      "lesson": "s04-u02",
      "requires": ["M02-T02"],
      "katas": [
        {
          "id": "M02-T02-K1",
          "title": "Vuelta de quintas",
          "brief": "Toca el arpegio 1-3-5-8 (grados 0 2 4 7) de Do, Sol, Re y La mayor, una tonalidad por ciclo.",
          "starter": "n(\"0 2 4 7\").scale(\"C:major\").s(\"piano\")",
          "solution": "n(\"0 2 4 7\").scale(\"<C G D A>:major\").s(\"piano\")",
          "cycles": 4,
          "assertions": [
            {
              "type": "usesFunction",
              "names": ["scale"]
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["C", "E", "G", "C"],
              "voice": "all",
              "cycle": 0
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["G", "B", "D", "G"],
              "voice": "all",
              "cycle": 1
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["D", "F#", "A", "D"],
              "voice": "all",
              "cycle": 2
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["A", "C#", "E", "A"],
              "voice": "all",
              "cycle": 3
            }
          ],
          "hints": ["`< >` también funciona dentro de `scale`: `scale(\"<C G>:major\")`."]
        },
        {
          "id": "M02-T02-K2",
          "title": "El lado de los bemoles",
          "brief": "Toca la escala completa de Fa, Si♭ y Mi♭ mayor, una por ciclo: cada una suma un bemol.",
          "starter": "n(\"0 1 2 3 4 5 6 7\").scale(\"F:major\").s(\"piano\")",
          "solution": "n(\"0 1 2 3 4 5 6 7\").scale(\"<F Bb Eb>:major\").s(\"piano\")",
          "cycles": 3,
          "assertions": [
            {
              "type": "usesFunction",
              "names": ["scale"]
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["F", "G", "A", "Bb", "C", "D", "E", "F"],
              "voice": "all",
              "cycle": 0
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["Bb", "C", "D", "Eb", "F", "G", "A", "Bb"],
              "voice": "all",
              "cycle": 1
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["Eb", "F", "G", "Ab", "Bb", "C", "D", "Eb"],
              "voice": "all",
              "cycle": 2
            }
          ],
          "hints": ["En Strudel el bemol de la tónica se escribe con `b`: `Bb`, `Eb`."]
        },
        {
          "id": "M02-T02-K3",
          "title": "Dos bemoles",
          "brief": "¿Qué tonalidad mayor tiene dos bemoles en la armadura? Toca el arpegio 1-3-5-8 de esa tonalidad.",
          "starter": "n(\"0 2 4 7\").scale(\"C:major\").s(\"piano\")",
          "solution": "n(\"0 2 4 7\").scale(\"Bb:major\").s(\"piano\")",
          "cycles": 1,
          "assertions": [
            {
              "type": "usesFunction",
              "names": ["n", "scale"]
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["Bb", "D", "F", "Bb"],
              "voice": "all"
            }
          ],
          "hints": [
            "Los bemoles entran en orden Si, Mi, La…: con dos bemoles (Si♭ y Mi♭), la tónica es el penúltimo bemol."
          ]
        }
      ]
    },
    {
      "id": "S04-U03",
      "title": "Transformar patrones",
      "goal": "Usar slow, fast, rev y palindrome sobre los grados.",
      "lesson": "s04-u03",
      "requires": ["M02-T03"],
      "katas": [
        {
          "id": "M02-T03-K1",
          "title": "Tónica, subdominante, dominante",
          "brief": "En Sol mayor, toca la tónica, la subdominante, la dominante y vuelve a la tónica.",
          "starter": "n(\"0\").scale(\"G:major\").s(\"piano\")",
          "solution": "n(\"0 3 4 0\").scale(\"G:major\").s(\"piano\")",
          "cycles": 1,
          "assertions": [
            {
              "type": "usesFunction",
              "names": ["n", "scale"]
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["G", "C", "D", "G"],
              "voice": "all"
            }
          ],
          "hints": ["Subdominante = grado IV (número 3 en `n`); dominante = grado V (número 4)."]
        },
        {
          "id": "M02-T03-K2",
          "title": "A media velocidad",
          "brief": "Toca la escala de Do mayor completa, pero que dure dos ciclos: usa `.slow`.",
          "starter": "n(\"0 1 2 3 4 5 6 7\").scale(\"C:major\").s(\"piano\")",
          "solution": "n(\"0 1 2 3 4 5 6 7\").scale(\"C:major\").slow(2).s(\"piano\")",
          "cycles": 2,
          "assertions": [
            {
              "type": "usesFunction",
              "names": ["slow"]
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["C", "D", "E", "F"],
              "voice": "all",
              "cycle": 0
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["G", "A", "B", "C"],
              "voice": "all",
              "cycle": 1
            }
          ],
          "hints": ["`.slow(2)` estira el patrón al doble de largo."]
        },
        {
          "id": "M02-T03-K3",
          "title": "Ida y vuelta",
          "brief": "En Fa mayor, sube de la subdominante a la tónica (grados IV a VIII) y, en el ciclo siguiente, baja por el mismo camino con `.palindrome`.",
          "starter": "n(\"3 4 5 6 7\").scale(\"F:major\").s(\"piano\")",
          "solution": "n(\"3 4 5 6 7\").scale(\"F:major\").palindrome().s(\"piano\")",
          "cycles": 2,
          "assertions": [
            {
              "type": "usesFunction",
              "names": ["palindrome"]
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["Bb", "C", "D", "E", "F"],
              "voice": "all",
              "cycle": 0
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["F", "E", "D", "C", "Bb"],
              "voice": "all",
              "cycle": 1
            }
          ],
          "hints": [
            "`.palindrome()` toca el patrón al derecho y al revés en ciclos alternos.",
            "En Fa mayor el grado IV es Si♭: por eso la escala lleva un bemol."
          ]
        }
      ]
    },
    {
      "id": "S04-U04",
      "title": "Mayor y menor",
      "goal": "Llevar una melodía de mayor a su relativa menor.",
      "lesson": "s04-u04",
      "requires": ["M02-T04"],
      "katas": [
        {
          "id": "M02-T04-K1",
          "title": "La menor natural",
          "brief": "Toca la escala de La menor natural de la tónica a la octava.",
          "starter": "n(\"0 1 2 3 4 5 6 7\").scale(\"C:major\").s(\"piano\")",
          "solution": "n(\"0 1 2 3 4 5 6 7\").scale(\"A:minor\").s(\"piano\")",
          "cycles": 1,
          "assertions": [
            {
              "type": "usesFunction",
              "names": ["scale"]
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["A", "B", "C", "D", "E", "F", "G", "A"],
              "voice": "all"
            }
          ],
          "hints": ["En Strudel la menor natural se llama `minor`."]
        },
        {
          "id": "M02-T04-K2",
          "title": "Misma melodía, otra luz",
          "brief": "Toca la melodía de grados 0 2 4 2 0 en Do mayor en el ciclo 1 y en su relativa menor en el ciclo 2.",
          "starter": "n(\"0 2 4 2 0\").scale(\"C:major\").s(\"piano\")",
          "solution": "n(\"0 2 4 2 0\").scale(\"<C:major A:minor>\").s(\"piano\")",
          "cycles": 2,
          "assertions": [
            {
              "type": "usesFunction",
              "names": ["scale"]
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["C", "E", "G", "E", "C"],
              "voice": "all",
              "cycle": 0
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["A", "C", "E", "C", "A"],
              "voice": "all",
              "cycle": 1
            }
          ],
          "hints": ["`< >` alterna la escala completa: `scale(\"<C:major A:minor>\")`."]
        },
        {
          "id": "M02-T04-K3",
          "title": "Encuentra la relativa",
          "brief": "Toca la escala completa de la relativa menor de Mi♭ mayor. Todas sus notas deben estar en la armadura de Mi♭.",
          "starter": "n(\"0 1 2 3 4 5 6 7\").scale(\"Eb:major\").s(\"piano\")",
          "solution": "n(\"0 1 2 3 4 5 6 7\").scale(\"C:minor\").s(\"piano\")",
          "cycles": 1,
          "assertions": [
            {
              "type": "usesFunction",
              "names": ["scale"]
            },
            {
              "type": "notesWithinScale",
              "scale": "Eb major"
            },
            {
              "type": "noteSequence",
              "pitchClasses": ["C", "D", "Eb", "F", "G", "Ab", "Bb", "C"],
              "voice": "all"
            }
          ],
          "hints": ["La relativa menor empieza en el 6.º grado de la mayor."]
        }
      ]
    }
  ],
  "boss": {
    "id": "M02-BOSS",
    "title": "Mayor y su relativa",
    "brief": "Melodía de 8 compases sobre un bajo: compases 1–4 en Sol mayor (bajo en Sol), compases 5–8 en Mi menor (bajo en Mi). Usa al menos 3 intervalos distintos.",
    "starter": "stack(\n  note(\"g2\").s(\"piano\"),\n  n(\"0 2 4 2\").scale(\"G3:major\").s(\"piano\")\n)",
    "cycles": 8,
    "assertions": [
      {
        "type": "usesFunction",
        "names": ["stack", "scale"]
      },
      {
        "type": "notesWithinScale",
        "scale": "G major"
      },
      {
        "type": "rootsPerBar",
        "roots": ["G", "G", "G", "G", "E", "E", "E", "E"]
      },
      {
        "type": "distinctMelodicIntervals",
        "min": 3
      }
    ],
    "rubric": [
      {
        "id": "scale",
        "label": "Todas las notas caen en la escala de cada sección",
        "weight": 3
      },
      {
        "id": "change",
        "label": "El cambio a la relativa se oye en el compás 5",
        "weight": 3
      },
      {
        "id": "code",
        "label": "Código claro y legible",
        "weight": 2
      },
      {
        "id": "music",
        "label": "La melodía tiene forma y cierre",
        "weight": 2
      }
    ],
    "passScore": 7
  }
}
