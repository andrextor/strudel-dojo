---
// Theme switch that cycles auto → light → dark. No framework: a tiny inline
// script sets data-theme on <html> and persists the choice. Auto removes the
// attribute so the prefers-color-scheme media query decides.
---

<button
  id="theme-toggle"
  type="button"
  class="inline-flex size-10 items-center justify-center rounded-control border border-dojo-hairline text-dojo-muted transition-colors hover:border-dojo-neon hover:text-dojo-neon"
  aria-label="Cambiar tema"
>
  <svg
    data-icon="auto"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="2" y="3" width="20" height="14" rx="2"></rect>
    <line x1="8" y1="21" x2="16" y2="21"></line>
    <line x1="12" y1="17" x2="12" y2="21"></line>
  </svg>
  <svg
    data-icon="light"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"
    ></path>
  </svg>
  <svg
    data-icon="dark"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<style>
  #theme-toggle svg {
    display: none;
  }
  #theme-toggle[data-choice="auto"] [data-icon="auto"],
  #theme-toggle[data-choice="light"] [data-icon="light"],
  #theme-toggle[data-choice="dark"] [data-icon="dark"] {
    display: block;
  }
</style>

<script is:inline>
  ;(() => {
    const btn = document.getElementById('theme-toggle')
    if (!btn) return
    const order = ['auto', 'light', 'dark']
    const labels = { auto: 'automático', light: 'claro', dark: 'oscuro' }
    const read = () => {
      try {
        return localStorage.getItem('dojo_theme') || 'auto'
      } catch {
        return 'auto'
      }
    }
    const apply = (choice) => {
      const root = document.documentElement
      if (choice === 'auto') root.removeAttribute('data-theme')
      else root.dataset.theme = choice
      btn.dataset.choice = choice
      btn.setAttribute('aria-label', `Tema: ${labels[choice]}. Pulsa para cambiar.`)
    }
    apply(read())
    btn.addEventListener('click', () => {
      const next = order[(order.indexOf(read()) + 1) % order.length]
      try {
        localStorage.setItem('dojo_theme', next)
      } catch {}
      apply(next)
    })
  })()
</script>
