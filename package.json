    "astro": "7.4.2",
    "lucide-preact": "1.61.0",
    "preact": "11.0.1",
    "tailwindcss": "4.3.3",
    "tonal": "6.5.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
